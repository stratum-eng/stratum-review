{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codra",
  "main": "./src/index.ts",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codra",
      "database_id": "a5d49edd-d809-4b54-a40c-8789c2a89968",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "codra-blobs",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "8ad29b395fb04433adf8ed5915b91a97",
      "preview_id": "fb61fd5b03274513a0903258c83797fa",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "codra-review-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "codra-review-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "retry_delay": 60,
        "max_retries": 3,
      },
    ],
  },
  "workflows": [
    {
      "name": "codra-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/2 * * * *"],
  },
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/dashboard*",
      "/jobs*",
      "/repos*",
      "/stats*",
      "/health*",
      "/api/*",
      "/auth/*",
      "/webhook*",
      "/settings*",
      "/account*",
    ],
  },
  "secrets": {
    "required": [
      "APP_PRIVATE_KEY",
      "GITHUB_APP_ID",
      "GITHUB_APP_WEBHOOK_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "LLM_CONFIG_ENCRYPTION_KEY",
      "CF_API_TOKEN",
      "CF_ACCOUNT_ID",
    ],
  },
  "vars": {
    "APP_URL": "https://codra.jlmx.workers.dev",
    "AUTH_CALLBACK_URL": "https://codra.jlmx.workers.dev/auth/github/callback",
    "BOT_USERNAME": "stratum-review",
    "GITHUB_APP_SLUG": "stratum-review",
    "DASHBOARD_ALLOWED_USERS": "jlamoreaux",
    "ENVIRONMENT": "production",
    "TELEMETRY_DISABLED": "true",
  },
}
